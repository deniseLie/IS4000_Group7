# DemoBank settings template. Copy to .env in the repository root and fill in the values; never commit .env.
# One file for both apps: the backend (backend/app/core/config.py) and Vite (frontend/vite.config.js, envDir '..').
# Where each key comes from: README.md, section 3 "API keys and secrets". Restart the backend after any change.
# REQUIRED = the app does not work without it. Everything else is optional or already has a working default.

# ---- Supabase project: logins and all data ------------------------------------------------------------------
# REQUIRED. Supabase -> Project Settings -> API: Project URL and the anon public key. Never the service_role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# ---- Model -------------------------------------------------------------------------------------------------
# REQUIRED for chat. An OpenRouter key (https://openrouter.ai/keys) or any OpenAI-compatible API.
LLM_API_KEY=your-private-model-key
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-haiku-5.5
# LangChain model provider; empty means openai, which also covers OpenRouter through LLM_BASE_URL.
# LLM_PROVIDER=openai
# Client chat insights classifier (0108); empty uses LLM_MODEL.
TALKING_POINTS_MODEL=
# Meeting agents (Brief Writer, Minutes Writer, Proposal Drafter) send strict nested JSON schemas; empty uses LLM_MODEL.
# MEETING_MODEL=
# api = LangChain/OpenRouter; codex = local ChatGPT-signed-in Codex CLI; claude = local signed-in Claude Code CLI.
# The CLIs never receive an app key. OpenRouter settings stay in place when you switch.
CHAT_TRANSPORT=api
CODEX_MODEL=gpt-5.6-luna
CODEX_CLI_PATH=codex
# CODEX_CLI_TIMEOUT_S=180
# Claude Code: an alias or full model name (CHAT_TRANSPORT=claude only).
CLAUDE_MODEL=haiku
CLAUDE_CLI_PATH=claude
# Parallel agents share this many CLI turns; the rest wait.
# CLAUDE_CLI_CONCURRENCY=3
# Seconds one CLI turn may take (1-900); a long RM turn may need more.
# CLAUDE_CLI_TIMEOUT_S=90

# ---- Pipeline ----------------------------------------------------------------------------------------------
# v2 = the v5 agent graph (planner -> agents -> compose). The code default is v1; the app is built and tested on v2.
PIPELINE=v2
# adaptive: the planner model plans ordinary client intents; rules: a clear single-topic question is planned by rules.
# Safety routing is the same either way.
# CLIENT_INTENT_ROUTING=adaptive
# Prompt versions are not set here: one table in code, VERSIONS in backend/app/services/prompts.py.

# ---- Knowledge search --------------------------------------------------------------------------------------
# Knowledge is read only from the database. Search is hybrid (keywords + embedding similarity, migration 0099) and falls
# back to keyword search when EMBEDDING_API_KEY is empty or the provider fails; the audit event records which ran.
# The embedding key is its own (never LLM_API_KEY); store the section vectors with python -m scripts.embed_knowledge.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_MIN_SIMILARITY=0.4
# EMBEDDING_TIMEOUT_S=5
# false turns off the chat-spelling table for search only.
KNOWLEDGE_RESPELL=true

# ---- Saved chats -------------------------------------------------------------------------------------------
# database = owned saved chats (needed for Michelle's records in chat); off = nothing is saved.
CONVERSATION_STORE=database
# REQUIRED with CONVERSATION_STORE=database and PIPELINE=v2. Generate once:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep it private and stable: a new value invalidates the stored snapshots (migration 0015). Never prefix it with VITE_.
CHECKPOINT_SIGNING_KEY=

# ---- Documents (Michelle's compliance review) --------------------------------------------------------------
# Quick document check after an upload. Must equal: select secret from compliance.precheck_keys where key_id='v1';
# Without it, uploads still work and the check says it is not switched on yet. Never prefix it with VITE_.
DOCUMENT_PRECHECK_SIGNING_KEY=
# template: fixed per-document rules (services/document_templates.py); notice: the model reads the review notice.
# PRECHECK_MODE=template
# Optional OCR for scanned documents: an absolute path to tesseract (image PDFs also need pdftoppm).
DOCUMENT_OCR_COMMAND=
DOCUMENT_OCR_LANGUAGES=eng
DOCUMENT_OCR_VISION_LANGUAGES=en-US
DOCUMENT_OCR_WORD_CONFIDENCE=80
DOCUMENT_OCR_MEAN_CONFIDENCE=90

# ---- Notification worker (Inbox reminders and notices) ----------------------------------------------------
# A private LOGIN role that only inherits demobank_worker (README section 3); never the postgres owner or a service key.
# Either run python -m app.worker, or set RUN_WORKER_IN_API=true to run it inside the API.
WORKER_DATABASE_URL=
RUN_WORKER_IN_API=false
WORKER_POLL_SECONDS=2

# ---- Meetings and Zoom (docs/setup/zoom-wsl.md) ------------------------------------------------------------
# Meeting lifecycle (minutes, follow-ups, recap). Off: meeting pages answer 503 meetings_unavailable.
MEETINGS_ENABLED=false
# The meeting worker: a private LOGIN role that only inherits demobank_meetings.
# MEETINGS_DATABASE_URL=postgresql://<meeting login>.<project-ref>:<password>@<pooler host>:5432/postgres?sslmode=require
# Stable private key for the meeting checkpoints (0137), 43+ characters; generate like CHECKPOINT_SIGNING_KEY.
# Leave the line commented out until you have a value: an empty value stops the backend from starting.
# MEETINGS_CHECKPOINT_SIGNING_KEY=
RUN_MEETING_WORKER_IN_API=false
MEETING_MODEL_TOKEN_BUDGET=200000
# Largest transcript accepted by POST /meetings/{id}/transcript-import, in bytes.
# MEETING_IMPORT_MAX_BYTES=2200000
# Zoom links: the folder made by python -m scripts.zoom_authorize. An owner-only folder (chmod 700), so the backend
# must run on macOS, Linux or WSL; the meetings are hosted by the Zoom account that signed in there.
# ZOOM_OAUTH_DIRECTORY=/home/<you>/.demobank-zoom
# Automatic transcripts from Zoom My Notes. The optional webhook listener (app.services.meetings.zoom_events) uses its
# own restricted login (demobank_meeting_ingress) and the Zoom app's webhook secret.
ZOOM_CAPTURE_ENABLED=false
# ZOOM_INGRESS_DATABASE_URL=postgresql://<ingress login>.<project-ref>:<password>@<pooler host>:5432/postgres
# ZOOM_WEBHOOK_SECRET=

# ---- API server --------------------------------------------------------------------------------------------
# The backend port; Vite's /api proxy reads it too.
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_TOKENS=4096
# LLM Gateway limits: seconds per attempt, retries on timeouts/429/5xx only, tokens per chat request.
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=1
LLM_REQUEST_TOKEN_BUDGET=24000
# Whole v2 task deadline, including knowledge/customer reads and model retries.
AGENT_TIMEOUT_S=65
# Tool calls one v5 `open` task may make (1-8).
# AGENT_TOOL_CALLS=4
# External read-only gateway (the RM Zoom meeting check): the only hosts it may call, and seconds per call.
EXTERNAL_HOSTS=api.zoom.us
EXTERNAL_TIMEOUT_S=5
# API gateway: body limit and in-process token buckets (per signed-in user / per guest address).
MAX_BODY_BYTES=65536
RATE_CAPACITY=30
RATE_REFILL_PER_S=1.0
GUEST_RATE_CAPACITY=20
GUEST_RATE_REFILL_PER_S=0.5
# JWT audience checked on every token, and seconds the Supabase JWKS keys are cached.
# JWT_AUDIENCE=authenticated
# JWKS_TTL_S=600
# Handover switches: VALIDATION_HANDOFF=1 offers one RM handoff for a withheld section in a saved case (any other
# value: off); RM_HANDOVER_CONFIRM=0 records a handover without asking her first (default 1: she confirms).
# VALIDATION_HANDOFF=
# RM_HANDOVER_CONFIRM=1

# ---- Browser -----------------------------------------------------------------------------------------------
# REQUIRED. Only VITE_ variables reach the browser, so only public values go here (the anon key is public).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_API_URL=/api

# ---- LangSmith tracing and evaluation ----------------------------------------------------------------------
# true sends one run per /chat request (nested steps and model calls) with chat text and synthetic records, after card
# numbers, emails, PINs, OTPs and NRICs are redacted (app/core/langsmith_client.py). The admin dashboard reads it too.
# The endpoint is the API host of your workspace's region, not the website: https://api.smith.langchain.com,
# https://eu.api.smith.langchain.com or https://apac.api.smith.langchain.com (the team workspace).
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
LANGSMITH_PROJECT=demobank-dev
LANGSMITH_TRACING=false
# Only for python -m evaluation.langsmith_run --judge: a grading model different from the answering model.
# It uses CHAT_TRANSPORT too: CODEX_MODEL for Codex answers, CLAUDE_MODEL for Claude Code answers, LLM_MODEL for API answers.
JUDGE_MODEL=
