# Keep the real .env private. This root file is read by both applications.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
LLM_API_KEY=your-private-model-key
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Talking points (0108): the model that classifies a client's message into topic codes; empty uses LLM_MODEL.
TALKING_POINTS_MODEL=
# api = existing LangChain/OpenRouter path; codex = local ChatGPT-signed-in CLI; claude = local signed-in Claude Code CLI.
# Restart the backend after switching. OpenRouter settings stay in place.
CHAT_TRANSPORT=api
PIPELINE=v1
# Knowledge is read only from the database (both pipelines). Search is hybrid (keyword + embedding similarity, migration
# 0099) and falls back to keyword search when EMBEDDING_API_KEY is empty or the provider fails; the audit event records
# which ran. The embedding key is its own (never LLM_API_KEY); store section vectors with python -m scripts.embed_knowledge.
# Fixed safety responses never read the database. KNOWLEDGE_RESPELL=false turns off the chat-spelling table for search only.
KNOWLEDGE_RESPELL=true
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_MIN_SIMILARITY=0.4
# After applying conversation migrations: database enables owned saved chats.
CONVERSATION_STORE=off
# Notification worker after migrations 0023–0025. Provision a private LOGIN role inheriting
# demobank_worker (no owner/superuser/BYPASSRLS/table privileges); see app/worker.py.
# Either python -m app.worker or opt in to running it with the API. Never use a service-role key.
WORKER_DATABASE_URL=
RUN_WORKER_IN_API=false
WORKER_POLL_SECONDS=2
# Hybrid meeting lifecycle: apply migrations 0120–0124 before opting in.
# Pre-meeting preparation through the original services.meetings seam remains unavailable.
MEETINGS_ENABLED=false
# Required for saved v2 workflows after migration 0015. Generate once with
# python -c 'import secrets; print(secrets.token_urlsafe(32))' and keep private/stable across replicas.
# Rotating this key invalidates existing workflow snapshots. Never prefix it with VITE_.
CHECKPOINT_SIGNING_KEY=
# Michelle: private backend HMAC key matching compliance.precheck_keys after migration 0056.
# See docs/workflows/workflow-2-michelle.md; never prefix these with VITE_.
DOCUMENT_PRECHECK_SIGNING_KEY=
# Optional absolute installed local OCR executable; image-PDF OCR also needs pdftoppm.
DOCUMENT_OCR_COMMAND=
DOCUMENT_OCR_LANGUAGES=eng
DOCUMENT_OCR_VISION_LANGUAGES=en-US
DOCUMENT_OCR_WORD_CONFIDENCE=80
DOCUMENT_OCR_MEAN_CONFIDENCE=90
CODEX_MODEL=gpt-5.6-luna
CODEX_CLI_PATH=codex
CLAUDE_MODEL=haiku          # alias or full model name; CHAT_TRANSPORT=claude only
CLAUDE_CLI_PATH=claude
# CLAUDE_CLI_CONCURRENCY=3   # parallel agents share this many CLI turns; the rest wait
PORT=8000
MAX_TOKENS=4096
PROMPT_VERSION=v2   # Answer prompt: backend/app/prompts/answer/<version>
# PROMPT_VERSIONS={"planner":"v1"}   # Other agents: backend/app/prompts/<agent>/<version>
# LLM Gateway limits: seconds per attempt, retries on timeouts/429/5xx only, tokens per chat request.
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=1
LLM_REQUEST_TOKEN_BUDGET=24000
# Whole v2 task deadline, including knowledge/customer reads and model retries.
AGENT_TIMEOUT_S=65
# External read-only tools (public holidays, indicative FX): the only hosts they may call, and seconds per call.
EXTERNAL_HOSTS=date.nager.at,api.frankfurter.dev
EXTERNAL_TIMEOUT_S=5
CORS_ORIGINS=["http://localhost:5173"]
# Only public browser configuration belongs in VITE_ variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_API_URL=/api
# API gateway: body limit and in-process token buckets (per signed-in user / per guest address).
MAX_BODY_BYTES=65536
RATE_CAPACITY=30
RATE_REFILL_PER_S=1.0
GUEST_RATE_CAPACITY=20
GUEST_RATE_REFILL_PER_S=0.5
# LangSmith: the app's tracing (one run per /chat request, with nested steps and model calls) and
# evaluation experiments (docs/evaluation/langsmith-evals-plan.md). true sends chat text and synthetic records, with
# card numbers, emails, PINs, OTPs and NRICs redacted first (app/core/langsmith_client.py). API host, not the
# web host: https://api.smith.langchain.com, https://eu.api.smith.langchain.com or https://apac.api.smith.langchain.com.
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=demobank-dev
LANGSMITH_TRACING=false
# Only for python -m evaluation.langsmith_run --judge: a grading model distinct from the answering model.
# Uses CHAT_TRANSPORT too: CODEX_MODEL for Codex answers, LLM_MODEL for API answers; gpt-6-luna is a local Codex judge example.
JUDGE_MODEL=

# Hybrid meeting lifecycle (explicit runtime opt-in; never use an owner/service login for the worker).
# ZOOM_OAUTH_DIRECTORY=/absolute/private/path/to/approved-oauth-files
# MEETINGS_DATABASE_URL=postgresql://restricted_meeting_login:...@.../postgres
RUN_MEETING_WORKER_IN_API=false
