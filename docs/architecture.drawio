etica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.615;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v32" target="v44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v97" value="codes only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#4a4f5a;strokeWidth=1.2;fontSize=11;fontColor=#4a4f5a;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v47" target="v59"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v98" value="caller JWT + RLS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#4a4f5a;strokeWidth=1.2;fontSize=11;fontColor=#4a4f5a;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.34;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v46" target="v48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v99" value="SQL + RLS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#4a4f5a;strokeWidth=1.2;fontSize=11;fontColor=#4a4f5a;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.432;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v50" target="v60"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v100" value="uploads" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#4a4f5a;strokeWidth=1.2;fontSize=11;fontColor=#4a4f5a;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v51" target="v62"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="497" y="1245"/><mxPoint x="605" y="1245"/></Array></mxGeometry></mxCell><mxCell id="v101" value="every event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#4a4f5a;strokeWidth=1.2;fontSize=11;fontColor=#4a4f5a;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.585;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v48" target="v63"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v102" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#4a4f5a;strokeWidth=1.2;fontSize=11;fontColor=#4a4f5a;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.43;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v63" target="v60"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="825" y="1392"/><mxPoint x="335" y="1392"/></Array></mxGeometry></mxCell><mxCell id="v103" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#4a4f5a;strokeWidth=1.2;fontSize=11;fontColor=#4a4f5a;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v55" target="v67"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1145" y="1245"/><mxPoint x="1270" y="1245"/></Array></mxGeometry></mxCell><mxCell id="v104" value="RPC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#4a4f5a;strokeWidth=1.2;fontSize=11;fontColor=#4a4f5a;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" edge="1" parent="1" source="v67" target="v66"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v105" value="vector" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#4a4f5a;strokeWidth=1.2;fontSize=11;fontColor=#4a4f5a;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" edge="1" parent="1" source="v67" target="v68"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v106" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#4a4f5a;strokeWidth=1.2;fontSize=11;fontColor=#4a4f5a;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.193;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v66" target="v69"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v107" value="seed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#4a4f5a;strokeWidth=1.2;fontSize=11;fontColor=#4a4f5a;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.228;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v74" target="v69"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v108" value="cited" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#4a4f5a;strokeWidth=1.2;fontSize=11;fontColor=#4a4f5a;labelBackgroundColor=#ffffff;fontFamily=Helvetica;dashed=1;" edge="1" parent="1" source="v75" target="v74"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v109" value="auth users" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#4a4f5a;strokeWidth=1.2;fontSize=11;fontColor=#4a4f5a;labelBackgroundColor=#ffffff;fontFamily=Helvetica;dashed=1;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.33;entryDx=0;entryDy=0;" edge="1" parent="1" source="v10" target="v60"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="48" y="1310"/></Array></mxGeometry></mxCell><mxCell id="v110" value="outbox" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#4a4f5a;strokeWidth=1.2;fontSize=11;fontColor=#4a4f5a;labelBackgroundColor=#ffffff;fontFamily=Helvetica;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.72;entryDx=0;entryDy=0;" edge="1" parent="1" source="v12" target="v60"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="125" y="1345"/></Array></mxGeometry></mxCell><mxCell id="v111" value="Component guide" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;fillStyle=solid;strokeColor=#c3c8d0;strokeWidth=1.2;fontColor=#2b2f38;fontSize=13;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=top;spacingTop=4;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20" y="1600" width="1520" height="580" as="geometry"/></mxCell><mxCell id="v112" value="&lt;b&gt;Web Client&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;React app for clients (guest or signed-in) and the RM workspace. Shows a section as each agent finishes, then the ordered answer; one Confirm / Cancel per offer group (or reply “yes”).&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="1650" width="476" height="92" as="geometry"/></mxCell><mxCell id="v113" value="1" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="1660" width="22" height="22" as="geometry"/></mxCell><mxCell id="v114" value="&lt;b&gt;Identity Provider&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;Supabase Auth signs users in and issues the JWT the backend checks. The rm / support role is administrator-set app_metadata.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="536" y="1650" width="476" height="92" as="geometry"/></mxCell><mxCell id="v115" value="2" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="546" y="1660" width="22" height="22" as="geometry"/></mxCell><mxCell id="v116" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;Entry point: JWT, rate and size limits, SSE. A client chat runs the client graph; a verified rm login runs the same graph with the RM catalogue.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1032" y="1650" width="476" height="92" as="geometry"/></mxCell><mxCell id="v117" value="3" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1042" y="1660" width="22" height="22" as="geometry"/></mxCell><mxCell id="v118" value="&lt;b&gt;Input Guardrail&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;Rules only: redacts, flags fraud wording, and gives secrets, lost card, human support and guest balance questions a fixed reply. No model.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="1754" width="476" height="92" as="geometry"/></mxCell><mxCell id="v119" value="4" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="1764" width="22" height="22" as="geometry"/></mxCell><mxCell id="v120" value="&lt;b&gt;Conversation Orchestrator&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;Orchestrator–workers on LangGraph. planner: rules, then one model call, then a plan check. agents run in parallel; gather allows one more wave; compose orders sections. A confirmation goes planner → act.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="536" y="1754" width="476" height="92" as="geometry"/></mxCell><mxCell id="v121" value="5" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="546" y="1764" width="22" height="22" as="geometry"/></mxCell><mxCell id="v122" value="&lt;b&gt;Agent runtime&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;The catalogue (one AgentSpec per agent: tools, intents, exports, offers) builds the planner prompt and checks plans. The shared runner: rules first, default reads per intent, tool loop (≤ 4 calls) for open tasks only.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1032" y="1754" width="476" height="92" as="geometry"/></mxCell><mxCell id="v123" value="6" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1042" y="1764" width="22" height="22" as="geometry"/></mxCell><mxCell id="v124" value="&lt;b&gt;Domain Agents&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;Five client agents and two RM agents, each limited to its own tools and fields. They never write and never call each other; they return a section, typed exports and offers.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="1858" width="476" height="92" as="geometry"/></mxCell><mxCell id="v125" value="7" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="1868" width="22" height="22" as="geometry"/></mxCell><mxCell id="v126" value="&lt;b&gt;Response Validator&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;Checks each section against that agent’s own evidence: sources exist, figures match. Exports count as evidence with provenance. A failed section is withheld.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="536" y="1858" width="476" height="92" as="geometry"/></mxCell><mxCell id="v127" value="8" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="546" y="1868" width="22" height="22" as="geometry"/></mxCell><mxCell id="v128" value="&lt;b&gt;Tool layer&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;Internal tools return each agent’s field view with row and date limits, after the policy check, under the caller’s JWT + RLS, audited (direct or MCP). External gateway: public holidays and FX, allow-listed hosts, codes only.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1032" y="1858" width="476" height="92" as="geometry"/></mxCell><mxCell id="v129" value="9" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1042" y="1868" width="22" height="22" as="geometry"/></mxCell><mxCell id="v130" value="&lt;b&gt;Shared Services&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;Customer Data reads; Action is the only writer (receipt + audit + outbox in one transaction). Offers are proposed commands on the same ledger: one group per reply, 30-minute expiry, run in order, idempotent.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="1962" width="476" height="92" as="geometry"/></mxCell><mxCell id="v131" value="10" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="1972" width="22" height="22" as="geometry"/></mxCell><mxCell id="v132" value="&lt;b&gt;LLM Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;One client for planner and agents: separate PLANNER_MODEL, strict JSON, timeout, retries, per-request token budget. OpenRouter, or a local Codex / Claude CLI. Failures are reported, never faked.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="536" y="1962" width="476" height="92" as="geometry"/></mxCell><mxCell id="v133" value="11" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="546" y="1972" width="22" height="22" as="geometry"/></mxCell><mxCell id="v134" value="&lt;b&gt;Background Worker&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;Delivers outbox events and deadline reminders to the in-app inbox. It never starts a chat turn.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1032" y="1962" width="476" height="92" as="geometry"/></mxCell><mxCell id="v135" value="12" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1042" y="1972" width="22" height="22" as="geometry"/></mxCell><mxCell id="v136" value="&lt;b&gt;Knowledge Layer&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;Approved article sections in the kb schema. Keyword search, or hybrid (keyword + pgvector similarity, merged by reciprocal rank fusion); falls back to keyword. Exact fees from kb.facts.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="2066" width="476" height="92" as="geometry"/></mxCell><mxCell id="v137" value="13" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="2076" width="22" height="22" as="geometry"/></mxCell><mxCell id="v138" value="&lt;b&gt;Operational Database&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;Supabase Postgres, the system of record. Row-level security on every customer table; append-only hash-chained audit log; offer groups (0100) and travel notices (0101).&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="536" y="2066" width="476" height="92" as="geometry"/></mxCell><mxCell id="v139" value="14" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="546" y="2076" width="22" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>