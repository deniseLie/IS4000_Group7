X=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3n65" target="v3n79"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v3n124" value="every event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#4a4f5a;strokeWidth=1.2;fontSize=11;fontColor=#4a4f5a;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.585;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3n61" target="v3n80"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v3n125" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#4a4f5a;strokeWidth=1.2;fontSize=11;fontColor=#4a4f5a;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.4318;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3n80" target="v3n77"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="825" y="1580" /><mxPoint x="335" y="1580" /></Array></mxGeometry></mxCell><mxCell id="v3n126" value="question + vector" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#4a4f5a;strokeWidth=1.2;fontSize=11;fontColor=#4a4f5a;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3n70" target="v3n83"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v3n127" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#4a4f5a;strokeWidth=1.2;fontSize=11;fontColor=#4a4f5a;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3n70" target="v3n76"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v3n128" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#4a4f5a;strokeWidth=1.2;fontSize=11;fontColor=#4a4f5a;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3772;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3n83" target="v3n84"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v3n129" value="auth users" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#4a4f5a;strokeWidth=1.2;fontSize=11;fontColor=#4a4f5a;labelBackgroundColor=#ffffff;fontFamily=Helvetica;dashed=1;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.3333;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3n10" target="v3n77"><mxGeometry relative="1" as="geometry" x="0.5"><Array as="points"><mxPoint x="48" y="1496" /></Array></mxGeometry></mxCell><mxCell id="v3n130" value="outbox" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#4a4f5a;strokeWidth=1.2;fontSize=11;fontColor=#4a4f5a;labelBackgroundColor=#ffffff;fontFamily=Helvetica;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.7222;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3n12" target="v3n77"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="125" y="1531" /></Array></mxGeometry></mxCell><mxCell id="v3n131" value="Component guide" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;fillStyle=solid;strokeColor=#c3c8d0;strokeWidth=1.2;fontColor=#2b2f38;fontSize=13;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=top;spacingTop=4;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20" y="1730" width="1520" height="730" as="geometry" /></mxCell><mxCell id="v3n132" value="&lt;b&gt;Web Client&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;React app. Clients (guest or signed-in) chat, request meetings and manage Data sharing; each agent’s section streams in, then the ordered answer with one Confirm / Cancel per offer group. RMs work in Today, Assistant and Schedule; admins in the quality dashboard.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="1780" width="476" height="100" as="geometry" /></mxCell><mxCell id="v3n133" value="1" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="1790" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n134" value="&lt;b&gt;Identity Provider&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;Supabase Auth signs users in and issues the JWT the backend checks. The rm, support and admin roles are administrator-set app_metadata, never user_metadata.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="536" y="1780" width="476" height="100" as="geometry" /></mxCell><mxCell id="v3n135" value="2" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="546" y="1790" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n136" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;Entry point: JWT, size and rate limits, SSE. /chat runs the client graph; /rm/assistant runs the RM graph for a verified rm login; /admin reads LangSmith for an admin.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1032" y="1780" width="476" height="100" as="geometry" /></mxCell><mxCell id="v3n137" value="3" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1042" y="1790" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n138" value="&lt;b&gt;Input Guardrail&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;Rules only, on the client path: redacts, flags fraud wording and the care flag, and gives secrets, lost card and human-support questions a fixed reply. An urgent card case gets fixed steps and one urgent RM request offer.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="1892" width="476" height="100" as="geometry" /></mxCell><mxCell id="v3n139" value="4" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="1902" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n140" value="&lt;b&gt;Tracing&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;One redacted LangSmith run per request, with planner, agent, loop, tool and compose spans (ids, codes and counts). Logs keep ids and counts only.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="536" y="1892" width="476" height="100" as="geometry" /></mxCell><mxCell id="v3n141" value="5" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="546" y="1902" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n142" value="&lt;b&gt;Client graph&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;planner: rules, then one model call, then plan checks (urgent card, guests get General only, links). Agents run in parallel; gather runs dependants once; compose orders sections and saves offers as one group. A yes / no to an open offer goes planner → act.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1032" y="1892" width="476" height="100" as="geometry" /></mxCell><mxCell id="v3n143" value="6" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1042" y="1902" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n144" value="&lt;b&gt;RM graph&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;Book check first: a client outside the RM’s book is refused and audited, no model. A workspace button or one planner call gives up to 5 tasks for the RM agents; the same gather; compose merges drafts and Calendar cards. It never writes.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="2004" width="476" height="100" as="geometry" /></mxCell><mxCell id="v3n145" value="7" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="2014" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n146" value="&lt;b&gt;Meeting graph (planned)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;Built by the meeting team behind MEETINGS_ENABLED. Starts from the meeting event queue (0105): a brief from records the client shared, minutes after the meeting; the RM reviews both. Until then callers report MeetingsUnavailable.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="536" y="2004" width="476" height="100" as="geometry" /></mxCell><mxCell id="v3n147" value="8" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="546" y="2014" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n148" value="&lt;b&gt;Agent runtime&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;The catalogue (one AgentSpec per agent: tools, intents, exports, offers) builds the planner prompt and checks plans. The shared runner: rules first, default reads per intent, a tool loop (≤ 4 calls) for open tasks only, then one answer call.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1032" y="2004" width="476" height="100" as="geometry" /></mxCell><mxCell id="v3n149" value="9" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1042" y="2014" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n150" value="&lt;b&gt;Domain Agents&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;Four client agents and three RM agents, each limited to its own tools and fields. They never write and never call each other; they return a section, typed exports and offers (client) or drafts and cards (RM).&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="2116" width="476" height="100" as="geometry" /></mxCell><mxCell id="v3n151" value="10" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="2126" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n152" value="&lt;b&gt;Response Validator&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;Checks each section against that agent’s own evidence: sources exist, figures match. Exports count as evidence with provenance. A failed section is withheld.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="536" y="2116" width="476" height="100" as="geometry" /></mxCell><mxCell id="v3n153" value="11" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="546" y="2126" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n154" value="&lt;b&gt;Tool layer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;Internal tools return each agent’s field view with row and date limits, after the policy check, under the caller’s JWT + RLS, audited (MCP or direct). External gateway: public holidays and FX, allow-listed hosts, codes only.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1032" y="2116" width="476" height="100" as="geometry" /></mxCell><mxCell id="v3n155" value="12" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1042" y="2126" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n156" value="&lt;b&gt;Shared Services&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;Customer Data reads. Action is the only client writer (receipt + audit + outbox in one transaction); offers are proposed actions, one group per reply, 30-minute expiry. RM writes are separate approved requests. Notification fills the inbox. Knowledge fixes spellings, gets the question’s vector from the Embedding API and calls Hybrid Search.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="2228" width="476" height="100" as="geometry" /></mxCell><mxCell id="v3n157" value="13" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="2238" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n158" value="&lt;b&gt;Chat insights&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;After a saved reply, with the client’s chat_topics consent, one model call may record a topic (24-hour hold; the client’s quotes never cross). The client can also share one through a “Let her know” offer. The RM sees list values only.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="536" y="2228" width="476" height="100" as="geometry" /></mxCell><mxCell id="v3n159" value="14" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="546" y="2238" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n160" value="&lt;b&gt;LLM Gateway&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;One client for planner and agents: strict JSON, timeout, retries, per-request token budget. OpenRouter, or a local Codex / Claude CLI. Failures are reported, never faked.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1032" y="2228" width="476" height="100" as="geometry" /></mxCell><mxCell id="v3n161" value="15" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1042" y="2238" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n162" value="&lt;b&gt;Background Worker&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;Delivers outbox events and deadline reminders to the in-app inbox. It never starts a chat turn.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="2340" width="476" height="100" as="geometry" /></mxCell><mxCell id="v3n163" value="16" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="2350" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n164" value="&lt;b&gt;Knowledge Layer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;Hybrid Search runs in Postgres: one ranking by keyword, one by vector (top 20 each), merged by reciprocal rank fusion:&lt;br&gt;&lt;b&gt;score = 1/(60 + keyword rank) + 1/(60 + vector rank)&lt;/b&gt;&lt;br&gt;A missing rank adds 0. No vector: keyword only (audited).&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="536" y="2340" width="476" height="100" as="geometry" /></mxCell><mxCell id="v3n165" value="17" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="546" y="2350" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n166" value="&lt;b&gt;Operational Database&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;Supabase Postgres, the system of record. Row-level security per client and RM book; append-only hash-chained audit log; offer groups (0100), meeting requests (0106) and the private meeting event queue (0105).&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1032" y="2340" width="476" height="100" as="geometry" /></mxCell><mxCell id="v3n167" value="18" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1042" y="2350" width="22" height="22" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
