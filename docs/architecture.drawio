<mxfile host="app.diagrams.net"><diagram id="arch" name="System Architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1440" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;DemoBank — System Architecture&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;" vertex="1" parent="1"><mxGeometry x="14" y="7" width="1267" height="22" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4b5563&quot;&gt;Arrows 1–8 follow a client chat question, R1–R4 an RM copilot question and M1–M4 a scheduled meeting. The dashed lane is planned and built by another team.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="14" y="32" width="1267" height="16" as="geometry"/></mxCell><mxCell id="c3" value="Client" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;strokeColor=#374151;fillColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="52" y="72" width="26" height="44" as="geometry"/></mxCell><mxCell id="c4" value="Relationship manager" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;strokeColor=#374151;fillColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="52" y="130" width="26" height="44" as="geometry"/></mxCell><mxCell id="c5" value="Team admin" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;strokeColor=#374151;fillColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="52" y="189" width="26" height="44" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Web Client&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4b5563&quot;&gt;React app: client chat, requests and uploads; RM workspace; admin dashboard.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;fontColor=#111827;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="130" y="72" width="209" height="130" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Identity Provider (Supabase Auth)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4b5563&quot;&gt;Signs users in and issues the JWT with their role.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;fontColor=#111827;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="130" y="238" width="209" height="72" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Operational Database — Supabase Postgres&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9ca3af;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#374151;arcSize=1;" vertex="1" parent="1"><mxGeometry x="14" y="338" width="331" height="418" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Customer and business records&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4b5563&quot;&gt;Accounts, cards, cases, tickets, meetings, consent and offers. Row-level security per client and RM book.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;fontColor=#111827;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="367" width="302" height="108" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Document Storage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4b5563&quot;&gt;Private bucket for uploads.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;fontColor=#111827;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="490" width="148" height="101" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Audit Log&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4b5563&quot;&gt;Append-only, hash-chained record of every read and decision.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;fontColor=#111827;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="184" y="490" width="148" height="101" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Outbox&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4b5563&quot;&gt;Events saved with each action, for the worker.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;fontColor=#111827;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="605" width="302" height="65" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Meeting event queue&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4b5563&quot;&gt;Meeting changes queued in the same transaction.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;fontColor=#111827;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="680" width="302" height="65" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Background Worker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4b5563&quot;&gt;Turns outbox events and deadlines into Inbox notices.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;fontColor=#111827;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="29" y="778" width="317" height="72" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Backend API — one FastAPI process&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9ca3af;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#374151;arcSize=1;" vertex="1" parent="1"><mxGeometry x="374" y="65" width="893" height="965" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4b5563&quot;&gt;Checks JWT, size and rate limit; streams replies.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;fontColor=#111827;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="389" y="94" width="238" height="83" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Input Guardrail&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4b5563&quot;&gt;Rules only: redacts secrets, flags fraud, sends fixed safety replies.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;fontColor=#111827;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="641" y="94" width="310" height="83" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Tracing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4b5563&quot;&gt;One redacted LangSmith trace per request.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;fontColor=#111827;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="965" y="94" width="288" height="83" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Client graph (LangGraph)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#374151;arcSize=1;" vertex="1" parent="1"><mxGeometry x="389" y="230" width="446" height="281" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;planner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4b5563&quot;&gt;Picks the agents: rules first, else one model call.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;fontColor=#111827;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="259" width="101" height="137" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;agents (in parallel)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4b5563&quot;&gt;Each task runs at the same time with its own agent.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;fontColor=#111827;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="508" y="259" width="101" height="137" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;gather&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4b5563&quot;&gt;Waits for all agents; runs dependent tasks next.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;fontColor=#111827;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="616" y="259" width="101" height="137" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;compose&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4b5563&quot;&gt;Orders sections; saves proposed actions as one offer.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;fontColor=#111827;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="724" y="259" width="101" height="137" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;act&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4b5563&quot;&gt;Carries out or cancels an offer on yes/no.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;fontColor=#111827;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="418" width="101" height="83" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;RM graph (LangGraph)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#374151;arcSize=1;" vertex="1" parent="1"><mxGeometry x="850" y="230" width="216" height="281" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;planner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4b5563&quot;&gt;Picks the agents: rules first, else one model call.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;fontColor=#111827;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="259" width="94" height="137" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;agents (in parallel), gather&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4b5563&quot;&gt;Same steps, RM agents, RM access only.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;fontColor=#111827;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="961" y="259" width="94" height="137" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;compose&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4b5563&quot;&gt;Orders sections; saves proposed actions as one offer.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;fontColor=#111827;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="418" width="194" height="83" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Meeting graph (planned)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#374151;arcSize=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1076" y="230" width="180" height="281" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;brief&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4b5563&quot;&gt;Meeting brief from records the client shared.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;fontColor=#111827;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1087" y="259" width="158" height="65" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;RM reviews the brief&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4b5563&quot;&gt;Approve, change or reject.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;fontColor=#111827;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1087" y="335" width="158" height="43" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;minutes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4b5563&quot;&gt;Minutes and action items after the meeting.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;fontColor=#111827;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1087" y="389" width="158" height="56" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;RM reviews the minutes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4b5563&quot;&gt;Approved items become tasks and requests.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;fontColor=#111827;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1087" y="452" width="158" height="54" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Agent runtime&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9ca3af;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#374151;arcSize=1;" vertex="1" parent="1"><mxGeometry x="389" y="526" width="878" height="173" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Agent runner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4b5563&quot;&gt;Reads the agent&#x27;s records (or up to 4 tool calls), then one model call writes the answer.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;fontColor=#111827;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="554" width="202" height="133" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Response Validator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4b5563&quot;&gt;Checks sources and figures; failed answers are held back.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;fontColor=#111827;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="612" y="554" width="202" height="133" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Client agents&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4b5563&quot;&gt;Guide, Accounts &amp; Cards, Security, Compliance &amp; Documents, Relationship &amp; Service.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;fontColor=#111827;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="857" y="554" width="198" height="133" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;RM agents&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4b5563&quot;&gt;RM Client Insight and RM Service Desk, own book only.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;fontColor=#111827;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1062" y="554" width="194" height="133" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Agent catalogue&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4b5563&quot;&gt;Each agent&#x27;s tools, fields, questions and offers.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;fontColor=#111827;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="389" y="727" width="209" height="101" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Tool layer (direct or MCP)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4b5563&quot;&gt;Permission check, then only allowed fields and rows.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;fontColor=#111827;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="612" y="727" width="209" height="101" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;LLM Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4b5563&quot;&gt;One model client: versioned prompts, strict JSON, retries, token budget.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;fontColor=#111827;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="857" y="727" width="410" height="101" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Shared services&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9ca3af;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#374151;arcSize=1;" vertex="1" parent="1"><mxGeometry x="389" y="857" width="878" height="162" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;Customer Data&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4b5563&quot;&gt;Read-only, audited snapshots of own records.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b7280;fontColor=#111827;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="886" width="137" height="122" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;Authorisation &amp; Consent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4b5563&quot;&gt;May this agent use this tool? Did the client