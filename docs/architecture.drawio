2;fontSize=11;fontColor=#4a4f5a;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3n70" target="v3n74"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v3n128" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#4a4f5a;strokeWidth=1.2;fontSize=11;fontColor=#4a4f5a;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3772;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3n83" target="v3n84"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v3n129" value="auth users" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#4a4f5a;strokeWidth=1.2;fontSize=11;fontColor=#4a4f5a;labelBackgroundColor=#ffffff;fontFamily=Helvetica;dashed=1;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.3333;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3n10" target="v3n77"><mxGeometry relative="1" as="geometry" x="0.5"><Array as="points"><mxPoint x="42" y="1506" /></Array></mxGeometry></mxCell><mxCell id="v3n130" value="outbox" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#4a4f5a;strokeWidth=1.2;fontSize=11;fontColor=#4a4f5a;labelBackgroundColor=#ffffff;fontFamily=Helvetica;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.7222;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3n12" target="v3n77"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="125" y="1541" /></Array></mxGeometry></mxCell><mxCell id="v3n131" value="Component guide" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;fillStyle=solid;strokeColor=#c3c8d0;strokeWidth=1.2;fontColor=#2b2f38;fontSize=13;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=top;spacingTop=4;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20" y="1740" width="1520" height="1006" as="geometry" /></mxCell><mxCell id="v3n132" value="&lt;b&gt;Web Client&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;React app. Clients (guest or signed-in) chat, request meetings, manage Data sharing and see meeting recaps; each agent’s section streams in, then the ordered answer with one Confirm / Cancel per offer group. RMs work in Today, Assistant and Schedule (meeting page: Prepare, Meet, Document, Follow up); admins in the quality dashboard.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="1790" width="476" height="112" as="geometry" /></mxCell><mxCell id="v3n133" value="1" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="1800" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n134" value="&lt;b&gt;Identity Provider&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;Supabase Auth signs users in and issues the JWT the backend checks. The rm, support and admin roles are administrator-set app_metadata, never user_metadata.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="536" y="1790" width="476" height="112" as="geometry" /></mxCell><mxCell id="v3n135" value="2" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="546" y="1800" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n136" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;Entry point: JWT, size and rate limits, SSE. /chat runs the client graph; /rm/assistant the RM graph for a verified rm login; /meetings the meeting workspace for the client and the RM; /admin reads LangSmith for an admin. Record and form routes (/customer, /consent, /tickets, …) call the shared services with no model.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1032" y="1790" width="476" height="112" as="geometry" /></mxCell><mxCell id="v3n137" value="3" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1042" y="1800" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n138" value="&lt;b&gt;Input rules&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;Shared rules that run before any model, with no model call. Both sides redact card numbers, emails, ID numbers and codes. Client (guardrail.py): flags fraud wording and care; secrets, lost card and human-support questions get a fixed reply, and an urgent card case fixed steps plus one urgent RM request offer. RM (rm/graph.py): client scope first; a client the RM does not serve is refused and audited.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="1914" width="476" height="112" as="geometry" /></mxCell><mxCell id="v3n139" value="4" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="1924" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n140" value="&lt;b&gt;Tracing&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;One redacted LangSmith run per request, with planner, agent, loop, tool and compose spans (ids, codes and counts). Logs keep ids and counts only.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="536" y="1914" width="476" height="112" as="geometry" /></mxCell><mxCell id="v3n141" value="5" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="546" y="1924" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n142" value="&lt;b&gt;Client graph&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;planner: rules, then one model call, then plan checks (urgent card, guests get General only, links). Agents run in parallel; gather runs dependants once; compose orders sections and saves offers as one group. A yes / no to an open offer goes planner → act.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1032" y="1914" width="476" height="112" as="geometry" /></mxCell><mxCell id="v3n143" value="6" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1042" y="1924" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n144" value="&lt;b&gt;RM graph&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;Client scope first: a client the RM does not serve is refused and audited, no model. A button, a rule or one planner call gives up to 5 tasks; compose merges drafts and cards. Code writes and streams the reports’ record sections and scores Today; the model writes the judgement. Nothing is written without the RM’s approval.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="2038" width="476" height="112" as="geometry" /></mxCell><mxCell id="v3n145" value="7" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="2048" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n146" value="&lt;b&gt;Meeting lifecycle (MEETINGS_ENABLED, 0120–0141)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;One durable graph per meeting (signed checkpoints, 0137): prepare, meet, minutes, follow up, waiting for the RM at each approval. RM steps run in the API under the RM’s login; Zoom, transcripts and timers in the meeting worker. SQL rechecks consent, sources and the exact version on every read and approval.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="536" y="2038" width="476" height="112" as="geometry" /></mxCell><mxCell id="v3n147" value="8" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="546" y="2048" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n148" value="&lt;b&gt;Agent runtime&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;The catalogue (one AgentSpec per chat agent, one MeetingAgentSpec per meeting agent) builds the planner prompt and checks plans. The shared runner (chat agents): rules first, fixed reads per intent, a tool loop (≤ 4 calls) for open tasks only, then one answer call.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1032" y="2038" width="476" height="112" as="geometry" /></mxCell><mxCell id="v3n149" value="9" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1042" y="2048" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n150" value="&lt;b&gt;Domain Agents&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;Four client agents and three RM agents, each limited to its own tools and fields, plus four meeting agents with fixed tools only. They never write and never call each other; they return a section, exports and offers (client), drafts and cards (RM), or references and quotes the RM approves (meeting).&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="2162" width="476" height="112" as="geometry" /></mxCell><mxCell id="v3n151" value="10" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="2172" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n152" value="&lt;b&gt;Response Validator&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;Checks each section against that agent’s own evidence: sources exist, figures match. Exports count as evidence with provenance. A failed section is withheld.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="536" y="2162" width="476" height="112" as="geometry" /></mxCell><mxCell id="v3n153" value="11" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="546" y="2172" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n154" value="&lt;b&gt;Tool layer · MCP Service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;Every agent read is a tool on one MCP server (app/mcp_server.py), in-process or over stdio for outside MCP clients. Internal tools return each agent’s field view with row and date limits, after the policy check, under the caller’s JWT + RLS, audited. Zoom tools create meeting links and fetch transcripts for the meeting lifecycle.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1032" y="2162" width="476" height="112" as="geometry" /></mxCell><mxCell id="v3n155" value="12" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1042" y="2172" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n156" value="&lt;b&gt;Shared Services&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;Customer Data reads. Authorisation: each agent only its tools, each user only their records. Consent: which client data the RM may see and for how long; off stops access at once. Approved Actions runs a change only after the client or the RM confirms it (receipt, audit and outbox in one transaction). Notification fills the inbox; Knowledge calls Hybrid Search.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="2286" width="476" height="112" as="geometry" /></mxCell><mxCell id="v3n157" value="13" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="2296" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n158" value="&lt;b&gt;Chat insights&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;After a saved reply, with the client’s chat_topics consent, one model call may add, update or put on hold a topic (v2, 0143; 24-hour hold before the RM sees it; her words are never stored, 0142). She can share one through a “Let her know” offer, or delete one with Undo for 7 days. The RM sees list values only.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="536" y="2286" width="476" height="112" as="geometry" /></mxCell><mxCell id="v3n159" value="14" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="546" y="2296" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n160" value="&lt;b&gt;LLM Gateway&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;One client for the planners, the chat agents and the meeting agents: strict JSON, timeout, retries, per-request token budget; hidden reasoning off for RM answers. OpenRouter, or a local Codex / Claude CLI. Failures are reported, never faked.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1032" y="2286" width="476" height="112" as="geometry" /></mxCell><mxCell id="v3n161" value="15" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1042" y="2296" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n162" value="&lt;b&gt;Background Worker&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;Delivers outbox events and recorded deadlines (checklist reminders, consent renewal notices) to the in-app inbox, and purges removed chat insights after 7 days. It never starts a chat turn.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="2410" width="476" height="112" as="geometry" /></mxCell><mxCell id="v3n163" value="16" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="2420" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n164" value="&lt;b&gt;Knowledge Layer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;Hybrid Search runs in Postgres: one ranking by keyword, one by vector (top 20 each), merged by reciprocal rank fusion:&lt;br&gt;&lt;b&gt;score = 1/(60 + keyword rank) + 1/(60 + vector rank)&lt;/b&gt;&lt;br&gt;A missing rank adds 0. No vector: keyword only (audited).&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="536" y="2410" width="476" height="112" as="geometry" /></mxCell><mxCell id="v3n165" value="17" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="546" y="2420" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n166" value="&lt;b&gt;Operational Database&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;Supabase Postgres, the system of record. Row-level security per client and per RM’s clients; append-only hash-chained audit log; offer groups (0100), meeting requests (0106), consent v2 grants (0109–0114), support tickets the bank teams work (0071), and the private meeting schema: event queue, briefs, minutes, timers, checkpoints (0105, 0120–0141).&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1032" y="2410" width="476" height="112" as="geometry" /></mxCell><mxCell id="v3n167" value="18" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1042" y="2420" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n171" value="Zoom&lt;br&gt;&lt;font style='font-size:10px' color='#6b7280'&gt;Meeting links for both; My Notes transcripts&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f6efe9;fillStyle=solid;strokeColor=#2b2f38;strokeWidth=1.5;fontColor=#2b2f38;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1330" y="450" width="200" height="52" as="geometry" /></mxCell><mxCell id="v3n172" value="signed webhooks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;endFill=0;strokeColor=#4a4f5a;strokeWidth=1.2;fontSize=10;fontColor=#4a4f5a;labelBackgroundColor=#ffffff;fontFamily=Helvetica;startArrow=classic;startFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3n21" target="v3n171"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v3n173" value="RM steps and approvals" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#4a4f5a;strokeWidth=1.2;fontSize=11;fontColor=#4a4f5a;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0.985;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3n15" target="v3n35"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1236" y="296" /></Array></mxGeometry></mxCell><mxCell id="v3n200" value="Bank teams&lt;br&gt;&lt;font style='font-size:10px' color='#6b7280'&gt;Mortgage and Lombard specialists · Compliance review team. Outside the prototype&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f6efe9;fillStyle=solid;strokeColor=#2b2f38;strokeWidth=1.5;dashed=1;fontColor=#2b2f38;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1620" width="200" height="72" as="geometry" /></mxCell><mxCell id="v3n201" value="19" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="29" y="1609" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n202" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;startFill=1;endArrow=classic;endFill=1;strokeColor=#4a4f5a;strokeWidth=1.2;fontSize=11;fontColor=#4a4f5a;labelBackgroundColor=#ffffff;fontFamily=Helvetica;dashed=1;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3n77" target="v3n200"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="284" y="1656" /></Array></mxGeometry></mxCell><mxCell id="v3n220" value="hand-off tickets ⇄ status + reply" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontColor=#4a4f5a;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1588" width="236" height="20" as="geometry" /></mxCell><mxCell id="v3n203" value="&lt;b&gt;Bank teams (outside the prototype)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;The specialist and compliance teams work hand-off tickets in the bank’s own case tools. The RM approves each hand-off; the ticket carries the client’s goal, timeline, needed documents and what was discussed. Their status and note return via support.set_ticket_status to My requests and the RM’s Ticket inbox. A demo SQL script stands in.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="2534" width="476" height="112" as="geometry" /></mxCell><mxCell id="v3n204" value="19" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="2544" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n218" value="&lt;b&gt;Meeting worker&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#6b7280'&gt;A separate process with a restricted database login (no RM JWT, no banking readers). It claims the private meeting event queue with a lease and runs the lifecycle graph: Zoom links and transcripts through the Zoom tools, then minutes; sends the RM a reminder the day before and a missing-notes check after; purges withdrawn or expired transcripts.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="536" y="2534" width="476" height="112" as="geometry" /></mxCell><mxCell id="v3n219" value="20" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="546" y="2544" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n212" value="&lt;font color='#6b7280'&gt;Meeting agents (meeting lifecycle only: fixed tools, no loop; SQL checks every output)&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#2b2f38;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="1052" width="600" height="18" as="geometry" /></mxCell><mxCell id="v3n213" value="Brief Writer&lt;br&gt;&lt;font style='font-size:10px' color='#6b7280'&gt;Picks cited records and questions&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e7f0f7;fillStyle=solid;strokeColor=#2b2f38;strokeWidth=1.5;fontColor=#2b2f38;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="505" y="1074" width="168" height="50" as="geometry" /></mxCell><mxCell id="v3n214" value="Proposal Drafter&lt;br&gt;&lt;font style='font-size:10px' color='#6b7280'&gt;Agenda and product facts for the client&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e7f0f7;fillStyle=solid;strokeColor=#2b2f38;strokeWidth=1.5;fontColor=#2b2f38;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="682" y="1074" width="168" height="50" as="geometry" /></mxCell><mxCell id="v3n215" value="Minutes Writer&lt;br&gt;&lt;font style='font-size:10px' color='#6b7280'&gt;Minutes and actions with quotes&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e7f0f7;fillStyle=solid;strokeColor=#2b2f38;strokeWidth=1.5;fontColor=#2b2f38;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="859" y="1074" width="168" height="50" as="geometry" /></mxCell><mxCell id="v3n216" value="Minutes Overview&lt;br&gt;&lt;font style='font-size:10px' color='#6b7280'&gt;Condenses long transcripts&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e7f0f7;fillStyle=solid;strokeColor=#2b2f38;strokeWidth=1.5;fontColor=#2b2f38;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1036" y="1074" width="168" height="50" as="geometry" /></mxCell><mxCell id="v3n217" value="each step → its agent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#4a4f5a;strokeWidth=1.2;fontSize=11;fontColor=#4a4f5a;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8521;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3n35" target="v3n46"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="agents" name="Agent design"><mxGraphModel dx="1560" dy="2764" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3600" pageHeight="1100" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v3n22" value="Client graph · /chat" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#5b6b82;strokeWidth=1.2;fontColor=#2b2f38;fontSize=13;fontStyle=1;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=4;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="31" y="81" width="420" height="380" as="geometry" /></mxCell><mxCell id="v3n23" value="6" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n24" value="planner&lt;br&gt;&lt;font style='font-size:10px' color='#6b7280'&gt;Plans agent tasks from the intent&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fdf3e3;fillStyle=solid;strokeColor=#2b2f38;strokeWidth=1.5;fontColor=#2b2f38;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="91" y="131" width="180" height="50" as="geometry" /></mxCell><mxCell id="v3n25" value="agent&lt;br&gt;&lt;font style='font-size:10px' color='#6b7280'&gt;Runs tasks in parallel&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fdf3e3;fillStyle=solid;strokeColor=#2b2f38;strokeWidth=1.5;fontColor=#2b2f38;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="91" y="211" width="180" height="50" as="geometry" /></mxCell><mxCell id="v3n26" value="gather&lt;br&gt;&lt;font style='font-size:10px' color='#6b7280'&gt;Consolidates agent results&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fdf3e3;fillStyle=solid;strokeColor=#2b2f38;strokeWidth=1.5;fontColor=#2b2f38;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="91" y="291" width="180" height="50" as="geometry" /></mxCell><mxCell id="v3n27" value="compose&lt;br&gt;&lt;font style='font-size:10px' color='#6b7280'&gt;Composes one reply for the client&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fdf3e3;fillStyle=solid;strokeColor=#2b2f38;strokeWidth=1.5;fontColor=#2b2f38;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="91" y="371" width="180" height="50" as="geometry" /></mxCell><mxCell id="v3n28" value="act&lt;br&gt;&lt;font style='font-size:10px' color='#6b7280'&gt;Runs or cancels the offer on a yes or no, without a model&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fdf3e3;fillStyle=solid;strokeColor=#2b2f38;strokeWidth=1.5;fontColor=#2b2f38;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="281" y="251" width="150" height="50" as="geometry" /></mxCell><mxCell id="v3n29" value="RM graph · /rm/assistant" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#5b6b82;strokeWidth=1.2;fontColor=#2b2f38;fontSize=13;fontStyle=1;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=4;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="471" y="81" width="270" height="380" as="geometry" /></mxCell><mxCell id="v3n30" value="7" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="460" y="70" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n31" value="planner&lt;br&gt;&lt;font style='font-size:10px' color='#6b7280'&gt;Checks the RM’s book, then plans agent tasks from the intent&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fdf3e3;fillStyle=solid;strokeColor=#2b2f38;strokeWidth=1.5;fontColor=#2b2f38;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="511" y="131" width="200" height="50" as="geometry" /></mxCell><mxCell id="v3n32" value="agent&lt;br&gt;&lt;font style='font-size:10px' color='#6b7280'&gt;Runs tasks in parallel&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fdf3e3;fillStyle=solid;strokeColor=#2b2f38;strokeWidth=1.5;fontColor=#2b2f38;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="511" y="211" width="200" height="50" as="geometry" /></mxCell><mxCell id="v3n33" value="gather&lt;br&gt;&lt;font style='font-size:10px' color='#6b7280'&gt;Consolidates agent results&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fdf3e3;fillStyle=solid;strokeColor=#2b2f38;strokeWidth=1.5;fontColor=#2b2f38;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="511" y="291" width="200" height="50" as="geometry" /></mxCell><mxCell id="v3n34" value="compose&lt;br&gt;&lt;font style='font-size:10px' color='#6b7280'&gt;Composes one reply for the RM&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fdf3e3;fillStyle=solid;strokeColor=#2b2f38;strokeWidth=1.5;fontColor=#2b2f38;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="511" y="371" width="200" height="50" as="geometry" /></mxCell><mxCell id="v3n35" value="Meeting lifecycle · /meetings&lt;br&gt;&lt;font style='font-size:10px;font-weight:normal' color='#6b7280'&gt;one durable graph per meeting; waits for the RM&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#5b6b82;strokeWidth=1.2;fontColor=#2b2f38;fontSize=13;fontStyle=1;fontFamily=Helvetica;align=left;verticalAlign=top;spacingTop=4;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="781" y="81" width="250" height="380" as="geometry" /></mxCell><mxCell id="v3n36" value="8" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="770" y="70" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n37" value="prepare&lt;br&gt;&lt;font style='font-size:10px' color='#6b7280'&gt;RM brief and client agenda drafted&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fdf3e3;fillStyle=solid;strokeColor=#2b2f38;strokeWidth=1.5;fontColor=#2b2f38;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="801" y="129" width="210" height="56" as="geometry" /></mxCell><mxCell id="v3n38" value="meet&lt;br&gt;&lt;font style='font-size:10px' color='#6b7280'&gt;Zoom or in person&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fdf3e3;fillStyle=solid;strokeColor=#2b2f38;strokeWidth=1.5;fontColor=#2b2f38;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="801" y="217" width="210" height="56" as="geometry" /></mxCell><mxCell id="v3n39" value="minutes&lt;br&gt;&lt;font style='font-size:10px' color='#6b7280'&gt;Drafted from the transcript or notes&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fdf3e3;fillStyle=solid;strokeColor=#2b2f38;strokeWidth=1.5;fontColor=#2b2f38;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="801" y="305" width="210" height="56" as="geometry" /></mxCell><mxCell id="v3n40" value="follow up&lt;br&gt;&lt;font style='font-size:10px' color='#6b7280'&gt;RM sends follow-ups and recap&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fdf3e3;fillStyle=solid;strokeColor=#2b2f38;strokeWidth=1.5;fontColor=#2b2f38;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="801" y="393" width="210" height="56" as="geometry" /></mxCell><mxCell id="v3n41" value="Agent runtime" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#5b6b82;strokeWid