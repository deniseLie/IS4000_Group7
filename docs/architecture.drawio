"geometry"/></mxCell><mxCell id="c85" value="&lt;b&gt;Identity Provider&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;Supabase Auth signs customers in and issues the JWT the backend checks.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="536" y="1680" width="476" height="88" as="geometry"/></mxCell><mxCell id="c86" value="2" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="546" y="1690" width="22" height="22" as="geometry"/></mxCell><mxCell id="c87" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;Entry point (POST /chat). Checks the JWT, rate-limits, streams status → answer → done.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1032" y="1680" width="476" height="88" as="geometry"/></mxCell><mxCell id="c88" value="3" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1042" y="1690" width="22" height="22" as="geometry"/></mxCell><mxCell id="c89" value="&lt;b&gt;Input Guardrail&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;Rules only. Redacts secrets; lost card, human-support and guest-balance questions get a fixed safe reply.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="1780" width="476" height="88" as="geometry"/></mxCell><mxCell id="c90" value="4" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="1790" width="22" height="22" as="geometry"/></mxCell><mxCell id="c91" value="&lt;b&gt;Conversation Orchestrator&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;Splits a message into tasks, ranks them (fraud first), runs agents, merges one reply. Today: one make_answer() pipeline.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="536" y="1780" width="476" height="88" as="geometry"/></mxCell><mxCell id="c92" value="5" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="546" y="1790" width="22" height="22" as="geometry"/></mxCell><mxCell id="c93" value="&lt;b&gt;Domain Agents&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;Five specialists with their own prompt and allowed tools. They never change data directly.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1032" y="1780" width="476" height="88" as="geometry"/></mxCell><mxCell id="c94" value="6" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1042" y="1790" width="22" height="22" as="geometry"/></mxCell><mxCell id="c95" value="&lt;b&gt;Shared Services&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;Customer Data reads only the signed-in customer&#x27;s records. Action makes every change: propose → confirm → receipt.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="1880" width="476" height="88" as="geometry"/></mxCell><mxCell id="c96" value="7" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="1890" width="22" height="22" as="geometry"/></mxCell><mxCell id="c97" value="&lt;b&gt;Response Validator&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;Releases a reply only if sources exist and figures match the data; otherwise withholds it and hands to a human.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="536" y="1880" width="476" height="88" as="geometry"/></mxCell><mxCell id="c98" value="8" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="546" y="1890" width="22" height="22" as="geometry"/></mxCell><mxCell id="c99" value="&lt;b&gt;LLM Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;One client for all model calls via OpenRouter. Versioned prompts, strict JSON, failures reported, never faked.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1032" y="1880" width="476" height="88" as="geometry"/></mxCell><mxCell id="c100" value="9" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1042" y="1890" width="22" height="22" as="geometry"/></mxCell><mxCell id="c101" value="&lt;b&gt;Background Worker&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;Handles scheduled and outbox events (reminders, card blocked) and sends in-app notifications.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="1980" width="476" height="88" as="geometry"/></mxCell><mxCell id="c102" value="10" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="1990" width="22" height="22" as="geometry"/></mxCell><mxCell id="c103" value="&lt;b&gt;Knowledge Layer&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;Approved article sections searched by keyword (Postgres full-text); read-only for the app; exact fees from kb.facts. Today: in-memory keyword search.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="536" y="1980" width="476" height="88" as="geometry"/></mxCell><mxCell id="c104" value="11" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="546" y="1990" width="22" height="22" as="geometry"/></mxCell><mxCell id="c105" value="&lt;b&gt;Operational Database&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;Supabase Postgres, the system of record. Row-level security on every customer table; audit log is append-only.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1032" y="1980" width="476" height="88" as="geometry"/></mxCell><mxCell id="c106" value="12" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1042" y="1990" width="22" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v2" name="v2"><mxGraphModel dx="1560" dy="2200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="2200" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v2" value="&lt;b&gt;DemoBank — System Architecture v2&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#6b7280&#x27;&gt;v5 orchestrator–workers graph · as built 4 Nov 2026 · IS4000 coursework demo · synthetic data only&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#2b2f38;fontFamily=Helvetica;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="430" height="70" as="geometry"/></mxCell><mxCell id="v3" value="Built" style="rounded=1;arcSize=6;whiteSpace=w