="168" height="50" as="geometry" /></mxCell><mxCell id="v3n55" value="RM Requests&lt;br&gt;&lt;font style='font-size:10px' color='#6b7280'&gt;Tickets, follow-ups, drafts, plan&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f1ecf7;fillStyle=solid;strokeColor=#2b2f38;strokeWidth=1.5;fontColor=#2b2f38;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="682" y="991" width="168" height="50" as="geometry" /></mxCell><mxCell id="v3n56" value="RM Calendar&lt;br&gt;&lt;font style='font-size:10px' color='#6b7280'&gt;Meetings, meeting requests, availability&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f1ecf7;fillStyle=solid;strokeColor=#2b2f38;strokeWidth=1.5;fontColor=#2b2f38;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="859" y="991" width="168" height="50" as="geometry" /></mxCell><mxCell id="v3n57" value="Tool layer · MCP Service" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#5b6b82;strokeWidth=1.2;fontColor=#2b2f38;fontSize=13;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=top;spacingTop=4;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="240" y="1196" width="1000" height="80" as="geometry" /></mxCell><mxCell id="v3n58" value="12" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="229" y="1185" width="22" height="22" as="geometry" /></mxCell><mxCell id="v3n59" value="Internal tools&lt;br&gt;&lt;font style='font-size:10px' color='#6b7280'&gt;Policy-checked, audited reads. Each agent sees only its fields, within row and date limits&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#2b2f38;strokeWidth=1.5;fontColor=#2b2f38;fontSize=12;fontFamily=Helvetica;align=cent