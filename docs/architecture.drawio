lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#6b7280&#x27;&gt;streamed sections · Confirm / Cancel · RM workspace&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#2b2f38;strokeWidth=1.5;fontColor=#2b2f38;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="560" y="100" width="260" height="60" as="geometry"/></mxCell><mxCell id="v9" value="1" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="549" y="89" width="22" height="22" as="geometry"/></mxCell><mxCell id="v10" value="Identity Provider&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#6b7280&#x27;&gt;Supabase Auth&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#2b2f38;strokeWidth=1.5;fontColor=#2b2f38;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="160" height="56" as="geometry"/></mxCell><mxCell id="v11" value="2" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="29" y="169" width="22" height="22" as="geometry"/></mxCell><mxCell id="v12" value="Background Worker&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#6b7280&#x27;&gt;outbox · reminders&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#2b2f38;strokeWidth=1.5;fontColor=#2b2f38;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="130" height="56" as="geometry"/></mxCell><mxCell id="v13" value="12" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;