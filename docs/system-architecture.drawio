ell id="c80" value="cited" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#4a4f5a;strokeWidth=1.2;fontSize=11;fontColor=#4a4f5a;labelBackgroundColor=#ffffff;fontFamily=Helvetica;dashed=1;" edge="1" parent="1" source="c55" target="c54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c81" value="lives in Postgres" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#4a4f5a;strokeWidth=1.2;fontSize=11;fontColor=#4a4f5a;labelBackgroundColor=#ffffff;fontFamily=Helvetica;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c49" target="c41"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="1430"/><mxPoint x="780" y="1388"/></Array></mxGeometry></mxCell><mxCell id="c82" value="Component guide" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;fillStyle=solid;strokeColor=#c3c8d0;strokeWidth=1.2;fontColor=#2b2f38;fontSize=13;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="1630" width="1520" height="460" as="geometry"/></mxCell><mxCell id="c83" value="&lt;b&gt;Web Client&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;React chat app for guests and signed-in customers. Streams replies and shows cited sources.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="1680" width="476" height="88" as="geometry"/></mxCell><mxCell id="c84" value="1" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="1690" width="22" height="22" as="geometry"/></mxCell><mxCell id="c85" value="&lt;b&gt;Identity Provider&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;Supabase Auth signs customers in and issues the JWT the backend checks.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="536" y="1680" width="476" height="88" as="geometry"/></mxCell><mxCell id="c86" value="2" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="546" y="1690" width="22" height="22" as="geometry"/></mxCell><mxCell id="c87" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;Entry point (POST /chat). Checks the JWT, rate-limits, streams status → answer → done.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1032" y="1680" width="476" height="88" as="geometry"/></mxCell><mxCell id="c88" value="3" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1042" y="1690" width="22" height="22" as="geometry"/></mxCell><mxCell id="c89" value="&lt;b&gt;Input Guardrail&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;Rules only. Redacts secrets; lost card, human-support and guest-balance questions get a fixed safe reply.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="1780" width="476" height="88" as="geometry"/></mxCell><mxCell id="c90" value="4" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="1790" width="22" height="22" as="geometry"/></mxCell><mxCell id="c91" value="&lt;b&gt;Conversation Orchestrator&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;Splits a message into tasks, ranks them (fraud first), runs agents, merges one reply. Today: one make_answer() pipeline.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="536" y="1780" width="476" height="88" as="geometry"/></mxCell><mxCell id="c92" value="5" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="546" y="1790" width="22" height="22" as="geometry"/></mxCell><mxCell id="c93" value="&lt;b&gt;Domain Agents&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;Five specialists with their own prompt and allowed tools. They never change data directly.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1032" y="1780" width="476" height="88" as="geometry"/></mxCell><mxCell id="c94" value="6" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1042" y="1790" width="22" height="22" as="geometry"/></mxCell><mxCell id="c95" value="&lt;b&gt;Shared Services&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;Customer Data reads only the signed-in customer&#x27;s records. Action makes every change: propose → confirm → receipt.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="1880" width="476" height="88" as="geometry"/></mxCell><mxCell id="c96" value="7" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="1890" width="22" height="22" as="geometry"/></mxCell><mxCell id="c97" value="&lt;b&gt;Response Validator&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;Releases a reply only if sources exist and figures match the data; otherwise withholds it and hands to a human.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="536" y="1880" width="476" height="88" as="geometry"/></mxCell><mxCell id="c98" value="8" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="546" y="1890" width="22" height="22" as="geometry"/></mxCell><mxCell id="c99" value="&lt;b&gt;LLM Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;One client for all model calls via OpenRouter. Versioned prompts, strict JSON, failures reported, never faked.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1032" y="1880" width="476" height="88" as="geometry"/></mxCell><mxCell id="c100" value="9" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1042" y="1890" width="22" height="22" as="geometry"/></mxCell><mxCell id="c101" value="&lt;b&gt;Background Worker&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;Handles scheduled and outbox events (reminders, card blocked) and sends in-app notifications.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="1980" width="476" height="88" as="geometry"/></mxCell><mxCell id="c102" value="10" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="1990" width="22" height="22" as="geometry"/></mxCell><mxCell id="c103" value="&lt;b&gt;Knowledge Layer&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;Approved article sections searched by keyword (Postgres full-text); read-only for the app; exact fees from kb.facts. Today: in-memory keyword search.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="536" y="1980" width="476" height="88" as="geometry"/></mxCell><mxCell id="c104" value="11" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="546" y="1990" width="22" height="22" as="geometry"/></mxCell><mxCell id="c105" value="&lt;b&gt;Operational Database&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#6b7280&#x27;&gt;Supabase Postgres, the system of record. Row-level security on every customer table; audit log is append-only.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fillStyle=solid;strokeColor=#c3c8d0;fontColor=#2b2f38;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=40;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1032" y="1980" width="476" height="88" as="geometry"/></mxCell><mxCell id="c106" value="12" style="ellipse;html=1;fillColor=#2b2f38;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1042" y="1990" width="22" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>